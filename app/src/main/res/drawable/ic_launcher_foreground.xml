<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer: a stylised tapering tail curve with three
    LED dots along its spine. Everything stays inside the 72dp safe zone
    (18dp..90dp) so no launcher mask can clip the mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tail body: outer edge up to the tip, inner edge back down to the base. -->
    <path
        android:fillColor="#FFF5F3FF"
        android:pathData="M32,84 C26,56 36,32 60,24 C70,20.5 78,24 79,31 C74,27 66,29 60,36 C46,52 44,66 48,84 Z" />

    <!-- LEDs along the spine. -->
    <path
        android:fillColor="#FF8B5CF6"
        android:pathData="M37.4,72 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />
    <path
        android:fillColor="#FF8B5CF6"
        android:pathData="M39.8,57 a2.4,2.4 0 1,0 4.8,0 a2.4,2.4 0 1,0 -4.8,0 Z" />
    <path
        android:fillColor="#FF8B5CF6"
        android:pathData="M48,43 a2.1,2.1 0 1,0 4.2,0 a2.1,2.1 0 1,0 -4.2,0 Z" />
</vector>
